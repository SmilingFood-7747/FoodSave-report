@startuml
title Backend Feedback Context Class Diagram
skinparam classAttributeIconSize 0
skinparam packageStyle folder
skinparam shadowing false
hide empty members

package "com" as pkg_com {
  package "smilingfood" as pkg_com_smilingfood {
    package "foodsave" as pkg_com_smilingfood_foodsave {
      package "backend" as pkg_com_smilingfood_foodsave_backend {
        package "feedback" as pkg_com_smilingfood_foodsave_backend_feedback {
          package "domain" as pkg_com_smilingfood_foodsave_backend_feedback_domain {
            package "model" as pkg_com_smilingfood_foodsave_backend_feedback_domain_model {
              package "aggregates" as pkg_com_smilingfood_foodsave_backend_feedback_domain_model_aggregates {
                class "Review" as feedback_Review <<AggregateRoot>> #E8EDF1 {
                  - id: Long
                  - reservationId: Long
                  - rating: Rating
                  - comment: ReviewComment?
                  - createdAt: Instant
                  --
                  + submit(reservationId: Long, rating: Rating, comment: ReviewComment?, now: Instant): Review
                  + pullEvents(): List<DomainEvent>
                }
                class "SupportRequest" as feedback_SupportRequest <<AggregateRoot>> #E8EDF1 {
                  - id: Long
                  - requesterAccountId: Long
                  - reservationId: Long?
                  - subject: String
                  - description: String
                  - status: SupportStatus
                  - createdAt: Instant
                  --
                  + open(accountId: Long, reservationId: Long?, subject: String, description: String): SupportRequest
                  + pullEvents(): List<DomainEvent>
                }
              }
              package "valueobjects" as pkg_com_smilingfood_foodsave_backend_feedback_domain_model_valueobjects {
                record "Rating" as feedback_Rating <<ValueObject>> #E8EDF1 {
                  - value: int {readOnly}
                  --
                  + of(value: int): Rating
                  + value(): int
                }
                record "ReviewComment" as feedback_ReviewComment <<ValueObject>> #E8EDF1 {
                  - text: String {readOnly}
                  --
                  + of(text: String): ReviewComment
                  + length(): int
                }
                enum "SupportStatus" as feedback_SupportStatus <<Enum>> #F1F1F1 {
                  OPEN
                  RESOLVED
                  CLOSED
                }
              }
              package "projections" as pkg_com_smilingfood_foodsave_backend_feedback_domain_model_projections {
                class "PickupExperience" as feedback_PickupExperience <<ExternalReadModel>> #E8EDF1 {
                  + reservationId: Long {readOnly}
                  + customerUserId: Long {readOnly}
                  + collected: boolean {readOnly}
                  + collectedAt: Instant? {readOnly}
                }
              }
              package "events" as pkg_com_smilingfood_foodsave_backend_feedback_domain_model_events {
                record "ReviewSubmitted" as feedback_ReviewSubmitted <<DomainEvent>> #E8EDF1 {
                  + reviewId: Long {readOnly}
                  + reservationId: Long {readOnly}
                  + rating: int {readOnly}
                }
                record "SupportRequestOpened" as feedback_SupportRequestOpened <<DomainEvent>> #E8EDF1 {
                  + requestId: Long {readOnly}
                  + requesterAccountId: Long {readOnly}
                  + reservationId: Long? {readOnly}
                }
              }
              package "commands" as pkg_com_smilingfood_foodsave_backend_feedback_domain_model_commands {
                record "SubmitReviewCommand" as feedback_SubmitReviewCommand <<Command>> #E8EDF1 {
                  + actorUserId: Long
                  + reservationId: Long
                  + rating: int
                  + comment: String?
                }
                record "OpenSupportRequestCommand" as feedback_OpenSupportRequestCommand <<Command>> #E8EDF1 {
                  + actorAccountId: Long
                  + reservationId: Long?
                  + subject: String
                  + description: String
                }
              }
              package "queries" as pkg_com_smilingfood_foodsave_backend_feedback_domain_model_queries {
                record "GetReviewByReservationQuery" as feedback_GetReviewByReservationQuery <<Query>> #E8EDF1 {
                  + actorUserId: Long
                  + reservationId: Long
                }
                record "GetSupportRequestQuery" as feedback_GetSupportRequestQuery <<Query>> #E8EDF1 {
                  + actorAccountId: Long
                  + requestId: Long
                }
              }
            }
            package "services" as pkg_com_smilingfood_foodsave_backend_feedback_domain_services {
              class "ReviewEligibilityPolicy" as feedback_ReviewEligibilityPolicy <<Policy>> #E8EDF1 {
                + requireEligible(experience: PickupExperience, actorUserId: Long, alreadyReviewed: boolean): void
              }
              interface "FeedbackCommandService" as feedback_FeedbackCommandService <<Service>> #E3E8F0 {
                + submitReview(command: SubmitReviewCommand): Review
                + openSupport(command: OpenSupportRequestCommand): SupportRequest
              }
              interface "FeedbackQueryService" as feedback_FeedbackQueryService <<Service>> #E3E8F0 {
                + getReview(query: GetReviewByReservationQuery): Review?
                + getSupport(query: GetSupportRequestQuery): SupportRequest?
              }
            }
            package "repositories" as pkg_com_smilingfood_foodsave_backend_feedback_domain_repositories {
              interface "ReviewRepository" as feedback_ReviewRepository <<Repository>> #E3E8F0 {
                + findByReservation(reservationId: Long): Review?
                + save(review: Review): void
              }
              interface "SupportRequestRepository" as feedback_SupportRequestRepository <<Repository>> #E3E8F0 {
                + findById(id: Long): SupportRequest?
                + save(request: SupportRequest): void
              }
            }
          }
          package "application" as pkg_com_smilingfood_foodsave_backend_feedback_application {
            package "internal" as pkg_com_smilingfood_foodsave_backend_feedback_application_internal {
              package "commandservices" as pkg_com_smilingfood_foodsave_backend_feedback_application_internal_commandservices {
                class "FeedbackCommandServiceImpl" as feedback_FeedbackCommandServiceImpl <<Service>> #E8EDF1 {
                  - reviews: ReviewRepository
                  - requests: SupportRequestRepository
                  - pickups: PickupExperiencePort
                  - eligibility: ReviewEligibilityPolicy
                  --
                  + submitReview(command: SubmitReviewCommand): Review
                  + openSupport(command: OpenSupportRequestCommand): SupportRequest
                }
              }
              package "queryservices" as pkg_com_smilingfood_foodsave_backend_feedback_application_internal_queryservices {
                class "FeedbackQueryServiceImpl" as feedback_FeedbackQueryServiceImpl <<Service>> #E8EDF1 {
                  - repository: ReviewRepository
                  - support: SupportRequestRepository
                  - pickups: PickupExperiencePort
                  --
                  + getReview(query: GetReviewByReservationQuery): Review?
                  + getSupport(query: GetSupportRequestQuery): SupportRequest?
                }
              }
            }
            package "acl" as pkg_com_smilingfood_foodsave_backend_feedback_application_acl {
              interface "PickupExperiencePort" as feedback_PickupExperiencePort <<ExternalContextPort>> #E3E8F0 {
                + findExperience(reservationId: Long): PickupExperience?
                + requireReservationAccess(reservationId: Long, accountId: Long): void
              }
            }
          }
          package "infrastructure" as pkg_com_smilingfood_foodsave_backend_feedback_infrastructure {
            package "persistence" as pkg_com_smilingfood_foodsave_backend_feedback_infrastructure_persistence {
              package "jpa" as pkg_com_smilingfood_foodsave_backend_feedback_infrastructure_persistence_jpa {
                package "adapters" as pkg_com_smilingfood_foodsave_backend_feedback_infrastructure_persistence_jpa_adapters {
                  class "ReviewRepositoryAdapter" as feedback_ReviewRepositoryAdapter <<Adapter>> #E8EDF1 {
                    - repository: ReviewJpaRepository
                    - mapper: ReviewPersistenceMapper
                    --
                    + findByReservation(reservationId: Long): Review?
                    + save(review: Review): void
                  }
                  class "SupportRequestRepositoryAdapter" as feedback_SupportRequestRepositoryAdapter <<Adapter>> #E8EDF1 {
                    - repository: SupportRequestJpaRepository
                    - mapper: SupportRequestPersistenceMapper
                    --
                    + findById(id: Long): SupportRequest?
                    + save(request: SupportRequest): void
                  }
                }
                package "entities" as pkg_com_smilingfood_foodsave_backend_feedback_infrastructure_persistence_jpa_entities {
                  class "ReviewJpaEntity" as feedback_ReviewJpaEntity <<PersistenceEntity>> #E8EDF1 {
                    - id: Long
                    - reservationId: Long
                    - comment: String?
                    - createdAt: Instant
                  }
                  class "SupportRequestJpaEntity" as feedback_SupportRequestJpaEntity <<PersistenceEntity>> #E8EDF1 {
                    - id: Long
                    - requesterAccountId: Long
                    - reservationId: Long?
                    - subject: String
                    - description: String
                    - status: String
                    - createdAt: Instant
                    - updatedAt: Instant
                  }
                }
                package "repositories" as pkg_com_smilingfood_foodsave_backend_feedback_infrastructure_persistence_jpa_repositories {
                  interface "ReviewJpaRepository" as feedback_ReviewJpaRepository <<Repository>> #E3E8F0 {
                    + findById(id: Long): Optional<ReviewJpaEntity>
                    + save(entity: ReviewJpaEntity): ReviewJpaEntity
                    + findByReservation(reservationId: Long): ReviewJpaEntity?
                  }
                  interface "SupportRequestJpaRepository" as feedback_SupportRequestJpaRepository <<Repository>> #E3E8F0 {
                    + findById(id: Long): Optional<SupportRequestJpaEntity>
                    + save(entity: SupportRequestJpaEntity): SupportRequestJpaEntity
                  }
                }
                package "transform" as pkg_com_smilingfood_foodsave_backend_feedback_infrastructure_persistence_jpa_transform {
                  class "ReviewPersistenceMapper" as feedback_ReviewPersistenceMapper <<Mapper>> #E8EDF1 {
                    + toDomain(entity: ReviewJpaEntity): Review
                    + toEntity(model: Review): ReviewJpaEntity
                  }
                  class "SupportRequestPersistenceMapper" as feedback_SupportRequestPersistenceMapper <<Mapper>> #E8EDF1 {
                    + toDomain(entity: SupportRequestJpaEntity): SupportRequest
                    + toEntity(model: SupportRequest): SupportRequestJpaEntity
                  }
                }
              }
            }
          }
          package "interfaces" as pkg_com_smilingfood_foodsave_backend_feedback_interfaces {
            package "rest" as pkg_com_smilingfood_foodsave_backend_feedback_interfaces_rest {
              package "resources" as pkg_com_smilingfood_foodsave_backend_feedback_interfaces_rest_resources {
                record "ReviewResource" as feedback_ReviewResource <<Resource>> #E8EDF1 {
                  + id: Long
                  + reservationId: Long
                  + rating: int
                  + comment: String?
                  + createdAt: Instant
                }
                record "SubmitReviewResource" as feedback_SubmitReviewResource <<Resource>> #E8EDF1 {
                  + reservationId: Long
                  + rating: int
                  + comment: String?
                }
                record "OpenSupportRequestResource" as feedback_OpenSupportRequestResource <<Resource>> #E8EDF1 {
                  + reservationId: Long?
                  + subject: String
                  + description: String
                }
                record "SupportRequestResource" as feedback_SupportRequestResource <<Resource>> #E8EDF1 {
                  + id: Long
                  + subject: String
                  + description: String
                  + reservationId: Long?
                  + status: String
                  + createdAt: Instant
                }
              }
              package "transform" as pkg_com_smilingfood_foodsave_backend_feedback_interfaces_rest_transform {
                class "ReviewResourceFromEntityAssembler" as feedback_ReviewResourceFromEntityAssembler <<Assembler>> #E8EDF1 {
                  + toResource(entity: Review): ReviewResource
                }
                class "SubmitReviewCommandFromResourceAssembler" as feedback_SubmitReviewCommandFromResourceAssembler <<Assembler>> #E8EDF1 {
                  + toCommand(resource: SubmitReviewResource, actor: AuthenticatedPrincipal): SubmitReviewCommand
                }
                class "OpenSupportRequestCommandFromResourceAssembler" as feedback_OpenSupportRequestCommandFromResourceAssembler <<Assembler>> #E8EDF1 {
                  + toCommand(resource: OpenSupportRequestResource, actor: AuthenticatedPrincipal): OpenSupportRequestCommand
                }
                class "SupportRequestResourceFromEntityAssembler" as feedback_SupportRequestResourceFromEntityAssembler <<Assembler>> #E8EDF1 {
                  + toResource(request: SupportRequest): SupportRequestResource
                }
              }
              class "FeedbackController" as feedback_FeedbackController <<Controller>> #E8EDF1 {
                - commands: FeedbackCommandService
                - queries: FeedbackQueryService
                --
                + submitReview(resource: SubmitReviewResource, actor: AuthenticatedPrincipal): ResponseEntity<ReviewResource>
                + openSupport(resource: OpenSupportRequestResource, actor: AuthenticatedPrincipal): ResponseEntity<SupportRequestResource>
                + getReviewByReservation(query: GetReviewByReservationQuery, actor: AuthenticatedPrincipal): ResponseEntity<ReviewResource>
                + getSupportRequest(query: GetSupportRequestQuery, actor: AuthenticatedPrincipal): ResponseEntity<SupportRequestResource>
              }
            }
          }
        }
        package "shared" as pkg_com_smilingfood_foodsave_backend_shared {
          package "domain" as pkg_com_smilingfood_foodsave_backend_shared_domain {
            package "model" as pkg_com_smilingfood_foodsave_backend_shared_domain_model {
              package "events" as pkg_com_smilingfood_foodsave_backend_shared_domain_model_events {
                interface "DomainEvent" as shared_DomainEvent <<Interface>> #E3E8F0 {
                  + eventId(): UUID
                  + occurredAt(): Instant
                }
              }
            }
          }
          package "interfaces" as pkg_com_smilingfood_foodsave_backend_shared_interfaces {
            package "security" as pkg_com_smilingfood_foodsave_backend_shared_interfaces_security {
              record "AuthenticatedPrincipal" as shared_AuthenticatedPrincipal <<Record>> #E8EDF1 {
                + accountId: Long
                + userId: Long
                + role: String
              }
            }
            package "rest" as pkg_com_smilingfood_foodsave_backend_shared_interfaces_rest {
              package "resources" as pkg_com_smilingfood_foodsave_backend_shared_interfaces_rest_resources {
                record "MessageResource" as shared_MessageResource <<Resource>> #E8EDF1 {
                  + message: String
                }
              }
            }
          }
        }
      }
    }
  }
}

